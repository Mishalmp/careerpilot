# Copy to .env (git-ignored) and adjust. Values below are local-development placeholders.
POSTGRES_PASSWORD=careerpilot_dev

# API settings (prefix CAREERPILOT_). The host port 5433 avoids clashing with another local Postgres.
CAREERPILOT_DATABASE_URL=postgresql+asyncpg://careerpilot:careerpilot_dev@127.0.0.1:5433/careerpilot

# Backups (see README, "Backups"). Make a key with: uv run python -m careerpilot.cli backup-key
# CAREERPILOT_BACKUP_KEY=
# If Postgres runs in Docker, run pg_dump/pg_restore inside its container (always the right version):
# CAREERPILOT_PG_CONTAINER=careerpilot-postgres-1

# Research agent (interview topics for a job). Pick a search service:
#   searxng  free, self-hosted (the SearXNG container is planned in the docker tools profile;
#            it must have JSON output enabled, see docs/phase-7/01-requirements.md section 4a)
#   brave    Brave Search API (needs a key; about 5 USD of monthly credit, card required, verify on brave.com)
# CAREERPILOT_SEARCH_PROVIDER=none
# CAREERPILOT_SEARXNG_URL=http://localhost:8080
# CAREERPILOT_BRAVE_API_KEY=
# Research also needs ANTHROPIC_API_KEY to read the pages it finds. Per-run limits:
# CAREERPILOT_RESEARCH_MAX_SEARCHES=10
# CAREERPILOT_RESEARCH_MAX_PAGES=12
# CAREERPILOT_RESEARCH_MAX_TOKENS=80000
