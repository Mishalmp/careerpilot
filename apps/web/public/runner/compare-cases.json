  { "name": "exact: string is not number", "mode": "exact", "actual": "1", "expected": 1, "equal": false },
  { "name": "exact: null is not empty list", "mode": "exact", "actual": null, "expected": [], "equal": false },
  { "name": "exact: nested objects", "mode": "exact", "actual": { "a": [1, { "b": 2 }] }, "expected": { "a": [1, { "b": 2 }] }, "equal": true },
  { "name": "exact: extra key", "mode": "exact", "actual": { "a": 1, "b": 2 }, "expected": { "a": 1 }, "equal": false },
  { "name": "exact: different length", "mode": "exact", "actual": [1], "expected": [1, 1], "equal": false },
